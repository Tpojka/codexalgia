{
  "manifest_version": 3,
  "name": "Codexalgia",
  "version": "1.0.0",
  "description": "Toolbar hip that hurts while Codex CLI is working and relaxes when Codex is ready.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Codexalgia: connecting…",
    "default_icon": {
      "16": "icons/hip-unknown-16.png",
      "32": "icons/hip-unknown-32.png",
      "48": "icons/hip-unknown-48.png",
      "128": "icons/hip-unknown-128.png"
    }
  },
  "icons": {
    "16": "icons/hip-ok-16.png",
    "32": "icons/hip-ok-32.png",
    "48": "icons/hip-ok-48.png",
    "128": "icons/hip-ok-128.png"
  }
}
